<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="mariadb" force="true"/>
        <!-- eigene Testdatenbank: Docker setzt DB_DATABASE=musicwiz als echte Umgebungsvariable (landet in $_SERVER, das
             Laravel zuerst liest) – daher auch <server>, sonst wären die Entwicklungsdaten weg. tests/TestCase prüft zusätzlich. -->
        <env name="DB_DATABASE" value="musicwiz_test" force="true"/>
        <server name="DB_DATABASE" value="musicwiz_test" force="true"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="LOOKUP_AUTO" value="false"/>
        <env name="CATEGORY_FILL" value="false"/>
        <env name="SORTNAMES_AUTO" value="false"/>
        <env name="FINGERPRINT_INBOX" value="false"/>
        <env name="COUNTS_IN_BACKGROUND" value="false"/>
        <env name="LOG_CHANNEL" value="testing" force="true"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
